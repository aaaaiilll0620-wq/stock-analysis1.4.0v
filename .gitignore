# 忽略環境變數文件 (含 FinMind token — 絕不上傳)
.env
*.env
# 忽略 Python 快取
__pycache__/
*.pyc
.pytest_cache/

# ---- 部署精簡:以下不要推上 GitHub (體積大 / 本機專用 / 會重生成) ----
# PyInstaller 打包產物
dist/
build/
*.spec
# 執行輸出 (回測報表、驗證 CSV 等)
outputs/
# 本機原始資料快取 (幾百 MB;雲端不需要,靠 cloud_cache 快照)
finmind_cache/
data/
backups/
# 編輯器 / 系統
.vscode/
.DS_Store

# ---- TEJ 匯出檔:一次性匯入來源,線上不需要 (2026-07-28) ----
# 這些 xlsx 是 tej_importer.py 的**輸入**,跑完就把資料寫進 ~/tej_cache,
# 之後全靠那份快取;app.py 在雲端一次也不會讀它們。
# 但它們有 835 MB,佔 HEAD 整個 checkout 的 95% —— Streamlit Cloud 每次部署
# 都在下載一批永遠用不到的東西。
#
# ⚠️ 「不追蹤」不等於「刪掉」:它們連同資料夾分類與檔名都永遠留在 git 歷史裡,
#    GitHub 上那份也還在。要拿回來:
#        git checkout c582422 -- tej_exports/
#    (c582422 = 移出版控前的最後一個 commit)
#    這一點很重要,因為本機那份手動備份沒有分資料夾,而「哪個檔屬於哪個 inbox」
#    正是 tej_importer 用來決定欄位怎麼解讀的依據。
tej_exports/inbox*/
# 例外:Industry.xlsx 只有 148 KB,而 app.py → core/industry_flow.py 真的會讀它,
# 雲端少了它「法人流向」分頁會掛。
!tej_exports/inbox_industry/

# ---- 例外:cloud_cache 是要『刻意提交』的 scores 快照,別忽略它 ----
!cloud_cache/
!cloud_cache/**

# ---- Codex 審查輪的 pytest basetemp(可重生,不是證據) 2026-08-09 ----
.pytest_codex_*/
*.tmp

# ---- 研究執行日誌:保留在本機當診斷紀錄,不進版控 ----
# ⚠ 例外:被預註冊 §7 引用的日誌是證據,已用 ! 規則排除在忽略之外
beat_0050/results/*.log
beat_0050/results/*.err.log
!beat_0050/results/overlay_all_2026-07-31.log

# ---- P0-U1 逐日期稽核明細:255 檔 / 30MB,可由 build_structural_audit.py
# 從 manifest.json 凍結的輸入完全重生(2026-08-12,使用者裁決)——比照上面
# beat_0050/results/*.log 的先例,只有彙總產物(report.md/manifest.json/
# metrics.json/canonical_universe_audit.csv/universe_audit.csv/
# portfolio_monthly.csv/portfolio_diff.csv)進版控,逐日期明細留在本機。
research/p0_u1_canonical_universe/canonical_universe_by_date/

# ---- P0-R1 資料輸入唯讀快照封存(FR-35,2026-08-12 使用者裁決):
# git hash-object -w 產生的 unreferenced loose object 可能被 git gc 清掉,
# 不能當長期保存手段;改用獨立複本(非 hard-link)常駐,約 90MB,不進版控。
# 只有彙總 manifest(data_snapshot_manifest.json)與逐檔 hash 進版控。
research/p0_r1_research_production_identity/data_snapshot/

# ============================================================================
# Repo & Provenance Finalization Closure (2026-08-18)
#
# 原則:原始輸入語料與大型二進位衍生物不進版控,改由 provenance hash 綁定;
# 來源程式、規格/裁決文件、證據 receipt 一律進版控 —— 證據不因大小被切開。
# ============================================================================

# E. 原始 TEJ 匯出語料(100 檔 / 2.3 GB)—— 這是 importer 的**輸入**,不是產物。
#    比照上面 tej_exports/inbox*/ 的既有先例。身分不靠檔案本身,靠下面這兩份
#    **已進版控**的 manifest 綁定:
#        tej_exports/DataExport0806_manifest.csv
#        tej_exports/DataExport0806_manifest.sha256
tej_exports/DataExport0806/

# F. 大型二進位衍生資料(parquet / npz)—— 可由已凍結的輸入完全重生,
#    逐檔 sha256 記在 provenance manifest。
research/p0_b09_value_reference/*.parquet
tej_exports/legacy_supplement/*.parquet
beat_0050/results/dual100_h3.npz

# F. 逐檔明細型稽核產物(12 MB)—— 比照 P0-U1
#    research/p0_u1_canonical_universe/canonical_universe_by_date/ 的既有裁決:
#    彙總產物進版控,逐項明細留在本機。
beat_0050/results/portfolio_v2/phase1/full_universe_audit_*.json
